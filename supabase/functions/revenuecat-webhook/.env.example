# 85Blends 2.3.0 — Phase B1. Placeholder-only example for local `supabase functions serve
# --env-file supabase/functions/revenuecat-webhook/.env` testing.
#
# Copy this file to `.env` in this same directory and fill in REAL values ONLY in that untracked
# copy (supabase/.gitignore ignores .env and .env.* — this .env.example file is explicitly
# un-ignored so it stays committed). NEVER put a real value in this file, and never commit a
# `.env` with real values — see supabase/README.md's Phase B1 section for what each variable is
# and where its real value should eventually live (Supabase's own secret management via
# `supabase secrets set`, configured in a future Phase C, not in this repo).

REVENUECAT_PROJECT_ID=your_revenuecat_project_id
REVENUECAT_V2_SECRET_API_KEY=your_revenuecat_v2_secret_api_key
REVENUECAT_WEBHOOK_AUTH_HEADER=your_configured_authorization_header_value
REVENUECAT_WEBHOOK_HMAC_SECRET=your_revenuecat_webhook_hmac_signing_secret
SUPABASE_DB_URL=postgres://user:password@host:5432/postgres
